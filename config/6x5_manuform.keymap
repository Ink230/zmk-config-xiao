#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC   |  1  |  2  |  3   |  4   |  5   |                    |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB   |  Q  |  W  |  E   |  R   |  T   |                    |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL  |  A  |  S  |  D   |  F   |  G   |                    |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT  |  Z  |  X  |  C   |  V   |  B   |                    |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            // |    2   |  2  | f   | 6    | 4    | 1    |                    | 2    | 1     | w     | s    | n     |  a    |

            bindings = <
&none             &none          &none           &none  &none      &none  &none  &none      &none      &none          &none             &none
&kp TAB           &kp Q          &kp W           &kp F  &kp P      &kp G  &kp J  &kp L      &kp U      &kp Y          &none             &none
&kp LEFT_SHIFT    &kp A          &kp R           &kp S  &kp T      &kp D  &kp H  &kp N      &kp E      &kp I          &kp O             &kp ENTER
&kp LEFT_CONTROL  &kp Z          &kp X           &kp C  &kp V      &kp B  &kp K  &kp M      &kp COMMA  &kp DOT        &none             &none
&none             &kp BACKSPACE  &kp LEFT_SHIFT  &mo 3  &kp SPACE  &none  &mo 2  &kp SPACE  &mo 1      &kp BACKSPACE  &kp LEFT_CONTROL  &mo 1
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Symbols {
            bindings = <
&none             &none          &none              &none      &none          &none            &none         &none        &none          &none          &none             &none
&kp TAB           &kp F2         &kp F3             &kp F4     &kp F5         &kp F6           &kp F7        &kp F8       &kp F9         &kp F10        &kp F11           &none
&kp LSHIFT        &kp MINUS      &kp PERCENT        &kp EQUAL  &kp SEMICOLON  &kp EXCLAMATION  &kp QUESTION  &kp COLON    &kp PLUS       &kp ASTERISK   &kp UNDERSCORE    &none
&kp LEFT_CONTROL  &kp F1         &kp DOUBLE_QUOTES  &kp GRAVE  &kp SQT        &kp TILDE        &kp CARET     &kp AT_SIGN  &kp AMPERSAND  &kp PIPE       &kp F12           &none
&none             &kp BACKSPACE  &kp LSHIFT         &mo 4      &kp SPACE      &none            &none         &kp SPACE    &none          &kp BACKSPACE  &kp LEFT_CONTROL  &none
            >;
        };

        Numbers {
            bindings = <
&none             &none          &none         &none                 &none           &none             &none              &none             &none                  &none          &none             &none
&kp TAB           &none          &none         &kp LEFT_PARENTHESIS  &kp LEFT_BRACE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp RIGHT_BRACE   &kp RIGHT_PARENTHESIS  &none          &none             &none
&kp LEFT_SHIFT    &kp NUMBER_1   &kp NUMBER_2  &kp NUMBER_3          &kp NUMBER_4    &kp N5            &kp NUMBER_6       &kp N7            &kp N8                 &kp N9         &kp N0            &none
&kp LEFT_CONTROL  &none          &none         &kp BACKSLASH         &kp LESS_THAN   &kp HASH          &none              &kp GREATER_THAN  &kp SLASH              &none          &none             &none
&none             &kp BACKSPACE  &kp LSHIFT    &none                 &kp SPACE       &none             &none              &kp SPACE         &none                  &kp BACKSPACE  &kp LEFT_CONTROL  &none
            >;
        };

        Nav {
            bindings = <
&none             &none          &none       &none  &none       &none     &none  &none             &none     &none              &none             &none
&kp TAB           &none          &none       &none  &none       &none     &none  &kp LEFT_BRACKET  &kp UP    &kp RIGHT_BRACKET  &none             &none
&kp LEFT_SHIFT    &none          &none       &none  &none       &none     &none  &kp LEFT          &kp DOWN  &kp RIGHT_ARROW    &none             &none
&kp LEFT_CONTROL  &none          &none       &none  &kp ESCAPE  &kp CLCK  &none  &kp MINUS         &none     &kp EQUAL          &none             &none
&none             &kp BACKSPACE  &kp LSHIFT  &none  &kp SPACE   &none     &none  &kp SPACE         &none     &kp BACKSPACE      &kp LEFT_CONTROL  &none
            >;
        };

        Controls {
            bindings = <
&none             &none  &none  &none  &none             &none  &none  &none              &none         &none         &none  &none
&kp TAB           &none  &none  &none  &ext_power EP_ON  &none  &none  &ext_power EP_OFF  &none         &none         &none  &none
&kp LEFT_SHIFT    &none  &none  &kp Q  &bt BT_CLR        &none  &none  &bt BT_SEL 0       &bt BT_SEL 1  &bt BT_SEL 2  &none  &none
&kp LEFT_CONTROL  &none  &none  &none  &none             &none  &none  &none              &none         &none         &none  &none
&none             &none  &none  &none  &none             &none  &none  &none              &none         &none         &none  &none
            >;
        };
    };
};
